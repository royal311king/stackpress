DATABASE_URL="file:../data/stackpress.db"
STACKPRESS_APP_URL="http://localhost:3000"
STACKPRESS_STORAGE_ROOT="./storage"
STACKPRESS_LOG_ROOT="./logs"
STACKPRESS_DATA_ROOT="./data"
STACKPRESS_TIMEZONE="America/Chicago"
# Base64-encoded 32-byte key used only to encrypt cloud OAuth tokens at rest.
# Generate once and keep it stable; losing it makes stored cloud tokens unreadable.
STACKPRESS_SECRET_KEY=""
# Temporary route-level admin protection until StackPress has first-class users/sessions.
STACKPRESS_ADMIN_USERNAME="admin"
STACKPRESS_ADMIN_PASSWORD=""
# Google Cloud Console OAuth 2.0 Web Application credentials.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Must exactly match the authorized redirect URI configured in Google Cloud Console.
# Use HTTPS for non-localhost production deployments.
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/cloud-storage/google/callback"
# Folder level beneath "StackPress Backups"; defaults to the machine hostname.
STACKPRESS_INSTALLATION_NAME=""
